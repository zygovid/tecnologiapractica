---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { sectionConfig, type SectionId } from '../lib/sections';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  sectionId: SectionId;
  cover?: ImageMetadata;
  coverAlt?: string;
  body?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  sectionId,
  cover,
  coverAlt,
  body,
} = Astro.props;

const section = sectionConfig(sectionId);
const minutes = readingMinutes(body);
const site = Astro.site ?? new URL('https://tecnologiapractica.com');
const canonical = new URL(Astro.url.pathname, site).href;
const coverUrl = cover ? new URL(cover.src, site).href : undefined;

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

const blogPosting = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'es-ES',
  keywords: tags.join(', '),
  author: { '@type': 'Organization', name: 'Tecnología Práctica' },
  publisher: { '@type': 'Organization', name: 'Tecnología Práctica' },
  mainEntityOfPage: canonical,
  ...(coverUrl ? { image: coverUrl } : {}),
};

const breadcrumbList = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: new URL('/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: section.label,
      item: new URL(section.basePath, site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonical,
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [blogPosting, breadcrumbList],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  ogImage={coverUrl}
  jsonLd={jsonLd}
>
  <Breadcrumbs sectionLabel={section.label} sectionHref={section.basePath} title={title} />

  <article class="prose">
    <p class="eyebrow">{section.label} · {category}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <p class="meta">
      Publicado el <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {updatedDate && <> · Actualizado el <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
      · {minutes} min de lectura
    </p>

    {cover && (
      <figure class="article-hero">
        <Picture
          src={cover}
          formats={['avif', 'webp']}
          alt={coverAlt ?? title}
          layout="constrained"
          width={1200}
          height={630}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <slot />

    {tags.length > 0 && (
      <ul class="tag-list" aria-label="Etiquetas del artículo">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    )}

    <div class="notice notice--safety">
      <strong>Seguridad:</strong> Los ejemplos de esta web usan baja tensión y material ligero.
      No los conectes a la red eléctrica ni a fuentes industriales. Si algo se calienta,
      huele raro o sale humo, desconecta y revisa antes de seguir.
    </div>

    {sectionId === 'automatizacion' && (
      <div class="notice">
        <strong>Aviso:</strong> Las instalaciones eléctricas industriales deben ser realizadas
        por personal cualificado según la normativa vigente. Verifica siempre esquemas y valores
        antes de aplicarlos en una máquina real.
      </div>
    )}

    <p class="back-link"><a href={section.basePath}>← Volver a {section.label}</a></p>
  </article>
</BaseLayout>

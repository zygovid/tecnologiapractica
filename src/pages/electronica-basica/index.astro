---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { sections } from '../../lib/sections';

const section = sections['electronica-basica'];

const posts = (await getCollection('blog', ({ data }) =>
  !data.draft && data.section === 'electronica-basica',
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byId = new Map(posts.map((post) => [post.id, post]));
const pick = (ids: string[]) => ids.map((id) => byId.get(id)).filter(Boolean);

const startHere = pick(['11-multimetro-digital', '17-ley-de-ohm', '14-led-resistencia']);

const modules = [
  {
    title: 'Medida y fundamentos',
    description: 'Herramientas básicas y cálculos para entender cualquier circuito.',
    steps: pick([
      '11-multimetro-digital',
      '17-ley-de-ohm',
      '12-codigo-colores-resistencias',
      '18-resistencias-serie-paralelo',
      '20-medir-corriente-multimetro',
    ]),
  },
  {
    title: 'Montaje y primeros circuitos',
    description: 'Componentes sencillos y prácticas seguras en protoboard.',
    steps: pick([
      '14-led-resistencia',
      '19-protoboard',
      '21-condensadores',
      '22-pulsadores-pull-up-pull-down',
      '16-conectores-basicos',
    ]),
  },
  {
    title: 'Componentes y control',
    description: 'Semiconductores, adaptación de señal y lectura de esquemas.',
    steps: pick([
      '23-diodos-polaridad-comprobacion',
      '24-transistor-como-interruptor',
      '25-divisor-tension-potenciometros',
      '27-reles-y-optoacopladores',
      '28-leer-esquema-electrico',
    ]),
  },
  {
    title: 'Alimentación y energía (5–12 V)',
    description: 'Fuentes, conversión, autonomía y protecciones básicas en baja tensión.',
    steps: pick([
      '26-alimentar-protoboard',
      '35-regulador-7805',
      '36-modulo-buck-lm2596',
      '37-alimentacion-usb-prototipos',
      '38-pilas-y-autonomia',
      '39-protecciones-fuente-diodo-fusible',
      '40-fuente-ajustable-protoboard',
    ]),
  },
];

const projectGroups = [
  {
    title: 'Control y automatismos',
    items: pick([
      '29-luz-nocturna-ldr-rele',
      '30-temporizador-555',
      '31-sensor-temperatura-comparador',
      '32-control-motor-dc-l298n',
      '33-semaforo-leds-temporizador',
      '34-alarma-pulsador-zumbador',
    ]),
  },
  {
    title: 'Alimentación',
    items: pick(['40-fuente-ajustable-protoboard']),
  },
];

const topics = [
  { href: '/electronica-basica/articulos/#herramientas', label: 'Herramientas y medida' },
  { href: '/electronica-basica/articulos/#fundamentos', label: 'Fundamentos y cálculo' },
  { href: '/electronica-basica/articulos/#componentes', label: 'Componentes' },
  { href: '/electronica-basica/articulos/#montaje', label: 'Montaje y control' },
  { href: '/electronica-basica/articulos/#alimentacion', label: 'Alimentación y energía' },
  { href: '/electronica-basica/articulos/#proyectos', label: 'Proyectos prácticos' },
];

const shortTitle = (post) => post.data.title.split(':')[0].trim();
---

<BaseLayout title={section.title} description={section.description}>
  <Breadcrumbs sectionLabel={section.label} sectionHref={section.basePath} />

  <header class="section-hero">
    <p class="tag">Guías para principiantes</p>
    <h1>{section.title}</h1>
    <p class="lead">{section.lead}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/electronica-basica/11-multimetro-digital/">Empezar desde cero</a>
      <a class="button button-secondary" href="/electronica-basica/articulos/">Índice por temas</a>
    </div>
  </header>

  <section class="start-here" aria-labelledby="empieza-aqui">
    <div class="block-head">
      <div>
        <p class="eyebrow">Primeros pasos</p>
        <h2 id="empieza-aqui">Empieza aquí</h2>
      </div>
      <p class="block-head__meta">3 guías esenciales</p>
    </div>
    <div class="article-list">
      {startHere.map((post) => post && <ArticleRow post={post} />)}
    </div>
  </section>

  <section class="learning-path" aria-labelledby="ruta-electronica">
    <p class="eyebrow">Ruta recomendada</p>
    <h2 id="ruta-electronica">Aprende por módulos</h2>
    <p class="lead">Sigue los módulos en orden. Cada uno agrupa los conceptos que conviene dominar antes de pasar al siguiente. Todos los artículos siguen siendo de baja tensión (5–12 V).</p>

    <div class="module-grid">
      {modules.map((mod, index) => (
        <article class="module-card">
          <p class="module-card__label">Módulo {index + 1}</p>
          <h3>{mod.title}</h3>
          <p class="module-card__desc">{mod.description}</p>
          <ol class="module-list">
            {mod.steps.map((post) => post && (
              <li>
                <a href={`${section.basePath}${post.id}/`}>{shortTitle(post)}</a>
                {post.data.category === 'Proyectos' && <span class="module-list__badge">Proyecto</span>}
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="projects" aria-labelledby="proyectos-practicos">
    <div class="block-head">
      <div>
        <p class="eyebrow">Práctica guiada</p>
        <h2 id="proyectos-practicos">Proyectos prácticos</h2>
      </div>
      <a class="section-block__link" href="/electronica-basica/articulos/#proyectos">Ver todos <span aria-hidden="true">→</span></a>
    </div>
    <p class="lead">Montajes con lista de materiales, esquema, pruebas y errores frecuentes.</p>
    {projectGroups.map((group) => (
      <div class="project-group">
        <h3>{group.title}</h3>
        <div class="project-grid">
          {group.items.map((post) => post && (
            <a class="project-card" href={`${section.basePath}${post.id}/`}>
              <span>{post.id.slice(0, 2)}</span>
              <h4>{shortTitle(post)}</h4>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="topics" aria-labelledby="explorar-temas">
    <p class="eyebrow">Índice completo</p>
    <h2 id="explorar-temas">Explorar por temas</h2>
    <p class="lead">Accede al listado agrupado de los {posts.length} artículos y proyectos.</p>
    <ul class="topic-list">
      {topics.map((topic) => (
        <li><a href={topic.href}>{topic.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .block-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; }
  .block-head h2 { margin: 0; }
  .block-head__meta { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .start-here { margin: 0 0 2.5rem; }

  .learning-path { margin: 0 0 2.5rem; padding: 1.5rem 0 2rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .learning-path h2 { margin-top: 0; }
  .module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .module-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.15rem; }
  .module-card__label { color: var(--accent); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.2rem; }
  .module-card h3 { margin: 0 0 0.3rem; font-size: 1.1rem; }
  .module-card__desc { color: var(--muted); font-size: 0.88rem; margin: 0 0 0.7rem; }
  .module-list { margin: 0; padding-left: 1.2rem; }
  .module-list li { margin: 0.3rem 0; font-size: 0.93rem; }
  .module-list a { font-weight: 600; }
  .module-list__badge { display: inline-block; margin-left: 0.4rem; font-size: 0.68rem; font-weight: 700; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.05rem 0.45rem; vertical-align: middle; }

  .projects { margin: 0 0 2.5rem; }
  .projects h2 { margin-top: 0; }
  .project-group + .project-group { margin-top: 1.25rem; }
  .project-group h3 { font-size: 1rem; margin: 0 0 0.5rem; color: var(--muted); font-weight: 700; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
  .project-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem; text-decoration: none; color: inherit; }
  .project-card:hover { border-color: var(--accent); text-decoration: none; }
  .project-card span { color: var(--accent); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-card h4 { font-size: 1rem; margin: 0.35rem 0 0.25rem; }
  .project-card p { color: var(--muted); font-size: 0.85rem; margin: 0; }

  .topics { margin: 0 0 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .topics h2 { margin-top: 0; }
  .topic-list { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .topic-list a { display: inline-block; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 0.45rem 0.9rem; font-size: 0.9rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .topic-list a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .block-head { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
    .module-grid, .project-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .module-card { padding: 0.9rem 0.95rem; }
    .module-card__desc { display: none; }
    .module-list li { font-size: 0.9rem; }
    .project-grid { gap: 0.6rem; }
    .project-card { padding: 0.85rem 0.95rem; }
    .project-card p { display: none; }
    .topic-list { gap: 0.45rem; }
    .topic-list a { font-size: 0.85rem; padding: 0.4rem 0.75rem; }
  }
</style>

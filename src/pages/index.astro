---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Tecnología Práctica"
  description="Automatización industrial, robótica y electrónica explicadas de forma práctica para técnicos, estudiantes y talleres."
>
  <section>
    <h1>Tecnología práctica, sin rodeos</h1>
    <p class="lead">
      Aquí explico automatización industrial, robótica y electrónica de forma clara y
      aplicable. Contenido para técnicos, estudiantes y talleres que quieren resolver
      problemas reales, no solo teoría.
    </p>

    <div class="notice">
      <strong>Estás empezando:</strong> la sección de <a href="/automatizacion/">Automatización industrial</a>
      es la primera que hemos desarrollado. Próximamente añadiremos electrónica, programación
      e IA aplicada.
    </div>

    <h2>Últimos artículos</h2>
    {posts.map((post) => (
      <a class="card" href={`/automatizacion/${post.id}/`} style="display:block;color:inherit;text-decoration:none">
        <p class="tag">{post.data.category}</p>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>

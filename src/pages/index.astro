---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { sections, visibleSectionIds } from '../lib/sections';

const posts = await getCollection('blog', ({ data }) =>
  !data.draft && visibleSectionIds.includes(data.section),
);

const grouped = visibleSectionIds.map((id) => ({
  section: sections[id],
  posts: posts
    .filter((post) => post.data.section === id)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
}));
---

<BaseLayout
  title="Tecnología Práctica"
  description="Electrónica básica explicada de forma clara y práctica: componentes, herramientas y circuitos para empezar desde cero."
>
  <section class="hero">
    <p class="tag">Electrónica desde cero</p>
    <h1>Tecnología práctica, sin rodeos</h1>
    <p class="lead">
      Aprende componentes, herramientas y circuitos de baja tensión con explicaciones claras,
      ejemplos reales y sin tecnicismos innecesarios.
    </p>
    <p class="hero__note">Guías pensadas para quien está empezando de verdad.</p>
  </section>

  {grouped.map(({ section, posts: sectionPosts }) => (
    <section class="section-block" aria-labelledby={`section-${section.id}`}>
      <div class="section-block__head">
        <div>
          <p class="eyebrow">Sección</p>
          <h2 id={`section-${section.id}`}>{section.title}</h2>
          <p>{section.lead}</p>
        </div>
        <a class="section-block__link" href={section.basePath}>Ver todos <span aria-hidden="true">→</span></a>
      </div>

      {sectionPosts.length > 0 ? (
        <div class="post-grid">
          {sectionPosts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
        </div>
      ) : (
        <p class="empty-state">Los primeros artículos de esta sección están en camino.</p>
      )}
    </section>
  ))}
</BaseLayout>

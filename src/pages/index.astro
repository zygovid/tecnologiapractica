---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { sections, visibleSectionIds } from '../lib/sections';

const posts = await getCollection('blog', ({ data }) =>
  !data.draft && visibleSectionIds.includes(data.section),
);

const grouped = visibleSectionIds.map((id) => {
  const sectionPosts = posts
    .filter((post) => post.data.section === id)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return {
    section: sections[id],
    posts: sectionPosts.slice(0, 6),
    total: sectionPosts.length,
  };
});

const siteUrl = Astro.site ?? new URL('https://tecnologiapractica.com');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tecnología Práctica',
  url: new URL('/', siteUrl).href,
  inLanguage: 'es-ES',
  publisher: {
    '@type': 'Organization',
    name: 'Tecnología Práctica',
    url: new URL('/', siteUrl).href,
  },
};
---

<BaseLayout
  title="Tecnología Práctica"
  description="Electrónica básica explicada de forma clara y práctica: componentes, herramientas y circuitos para empezar desde cero."
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="tag">Electrónica desde cero</p>
    <h1>Tecnología práctica, sin rodeos</h1>
    <p class="lead">
      Aprende componentes, herramientas y circuitos de baja tensión con explicaciones claras,
      ejemplos reales y sin tecnicismos innecesarios.
    </p>
    <p class="hero__note">Guías pensadas para quien está empezando de verdad.</p>
  </section>

  {grouped.map(({ section, posts: sectionPosts, total }) => (
    <section class="section-block" aria-labelledby={`section-${section.id}`}>
      <div class="section-block__head">
        <div>
          <p class="eyebrow">Sección</p>
          <h2 id={`section-${section.id}`}>{section.title}</h2>
          <p>{section.lead}</p>
        </div>
        <a class="section-block__link" href={`${section.basePath}articulos/`}>
          Ver los {total} artículos <span aria-hidden="true">→</span>
        </a>
      </div>

      {sectionPosts.length > 0 ? (
        <div class="article-list">
          {sectionPosts.map((post) => <ArticleRow post={post} />)}
        </div>
      ) : (
        <p class="empty-state">Los primeros artículos de esta sección están en camino.</p>
      )}
      <p class="section-block__more">
        <a href={section.basePath}>Ruta de aprendizaje</a>
        <span aria-hidden="true"> · </span>
        <a href={`${section.basePath}articulos/`}>Índice completo</a>
      </p>
    </section>
  ))}
</BaseLayout>
